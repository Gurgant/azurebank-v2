{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  /*
    The Playwright config and the E2E specs belong here, not in tsconfig.app.json: they run in
    node, not in the browser bundle. Without this they were typechecked by NOTHING — `tsc -b`
    covered only `src` and `vite.config.ts`, and Playwright transpiles specs without checking
    types, so a bad locator signature or a wrong import would have surfaced as a runtime failure
    at best and silently at worst. `npm run build` is this repo's type gate; it has to see them.
  */
  "include": ["vite.config.ts", "playwright.config.ts", "e2e"]
}
