meta {
  name: Get User by AzureTag
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/users/{{recipientAzureTag}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

docs {
  WHY THE PAYEE AND NOT OURSELVES. This lookup is what the transfer form calls to check a
  payee, and the API answers about OTHER people: measured 2026-09-21, a user looking up its
  OWN tag gets {exists: false, displayName: ""} while another user's tag gets
  {exists: true, displayName: "Other U."}. Pointed at {{testAzureTag}} this request asserted
  exists:true against the one tag that always answers false.
}

assert {
  res.status: eq 200
  res.body.data.exists: eq true
  res.body.data.azureTag: eq {{recipientAzureTag}}
}

tests {
  test("Status is 200 OK", function() {
    expect(res.status).to.equal(200);
  });

  test("Response contains user lookup result", function() {
    const data = res.body.data;
    expect(data).to.have.property('azureTag');
    expect(data).to.have.property('displayName');
    expect(data).to.have.property('exists');
  });
}
