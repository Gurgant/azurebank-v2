meta {
  name: A tag nobody holds
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/users/nobody_{{$timestamp}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

docs {
  WHAT THIS USED TO BE. This request was `Search Users`, GET /api/users/search?azureTag=...,
  and it asserted that `data` was an ARRAY of users. There is no such endpoint: the contract
  publishes exactly one GET under /api/users, and it is /api/users/{azureTag}. So the request
  was sending the literal word `search` AS the tag, and the API answered 200 with
  {azureTag: "search", displayName: "", exists: false} -- green for the wrong reason, against
  a list API that was never built. Measured 2026-09-21.

  It is now the MISS case of the real lookup, which is worth having next to the hit case in
  get-user-by-tag: a tag nobody holds is not a 404, it is a 200 that says so.
}

assert {
  res.status: eq 200
  res.body.data.exists: eq false
}

tests {
  test("Status is 200 OK", function() {
    expect(res.status).to.equal(200);
  });

  test("A tag nobody holds answers 200 with exists false, not 404", function() {
    expect(res.body.data.exists).to.equal(false);
    expect(res.body.data).to.have.property('azureTag');
    expect(res.body.data).to.have.property('displayName');
  });
}
