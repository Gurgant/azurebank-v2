meta {
  name: Create Account
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/accounts
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Test Savings Account",
    "type": "Savings"
  }
}

script:post-response {
  // The SECOND account of this user: transfers/internal-transfer moves money between two
  // accounts and had no way to name one. Measured 2026-09-21 before this existed, an empty
  // {{secondAccountId}} reached the API as "" and answered 400, 'The JSON value could not
  // be converted to System.Guid'.
  if (res.getStatus() === 201) {
    bru.setVar('secondAccountId', res.body.data.id);
  }
}

assert {
  res.status: eq 201
  res.body.data.name: eq "Test Savings Account"
  res.body.data.type: eq "Savings"
}

tests {
  test("Status is 201 Created", function() {
    expect(res.status).to.equal(201);
  });

  test("Account name matches request", function() {
    expect(res.body.data.name).to.equal("Test Savings Account");
  });

  test("Account type is the string Savings, as the contract serialises it", function() {
    expect(res.body.data.type).to.equal('Savings');
  });

  test("New account starts with zero balance", function() {
    expect(res.body.data.balance).to.equal(0);
  });

  test("New account is not primary", function() {
    expect(res.body.data.isPrimary).to.equal(false);
  });
}
