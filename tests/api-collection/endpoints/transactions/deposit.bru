meta {
  name: Deposit
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/transactions/deposit
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Content-Type: application/json
  Idempotency-Key: {{$randomUUID}}
}

body:json {
  {
    "accountId": "{{accountId}}",
    "amount": 1000.00,
    "description": "Test deposit"
  }
}

script:post-response {
  // Publish nothing unless this request actually succeeded: a failed request that
  // still writes its variables replaces a good value with an empty one, and every
  // request after it then fails for the wrong reason. Measured 2026-09-21: a 201
  // was assumed and a 401 overwrote the token, turning one broken request into fifteen.
  if (res.getStatus() === 201) {
    bru.setVar('transactionId', res.body.data.transaction.id);
  }
}

assert {
  res.status: eq 201
  res.body.data.transaction.type: eq "Deposit"
  res.body.data.transaction.amount: eq 1000
}

tests {
  test("Status is 201 Created", function() {
    expect(res.status).to.equal(201);
  });

  test("Transaction type is the string Deposit", function() {
    expect(res.body.data.transaction.type).to.equal('Deposit');
  });

  test("Amount matches request", function() {
    expect(res.body.data.transaction.amount).to.equal(1000);
  });

  test("New balance is returned", function() {
    expect(res.body.data.newBalance).to.be.a('number');
    expect(res.body.data.newBalance).to.be.greaterThanOrEqual(1000);
  });

  test("Transaction has all required properties", function() {
    const tx = res.body.data.transaction;
    expect(tx).to.have.property('id');
    expect(tx).to.have.property('transactionNumber');
    expect(tx).to.have.property('type');
    expect(tx).to.have.property('amount');
    expect(tx).to.have.property('balanceAfter');
    expect(tx).to.have.property('status');
    expect(tx).to.have.property('createdAt');
  });
}
