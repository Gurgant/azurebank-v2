meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "azureTag": "{{testAzureTag}}{{$timestamp}}",
    "email": "test.{{$timestamp}}@example.com",
    "password": "{{testPassword}}",
    "firstName": "{{testFirstName}}",
    "lastName": "{{testLastName}}"
  }
}

script:post-response {
  // Publish nothing unless this request actually succeeded: a failed request that
  // still writes its variables replaces a good value with an empty one, and every
  // request after it then fails for the wrong reason. Measured 2026-09-21: a 201
  // was assumed and a 401 overwrote the token, turning one broken request into fifteen.
  if (res.getStatus() === 201) {
    bru.setVar('authToken', res.body.data.token.accessToken);
    bru.setVar('accountId', res.body.data.account.id);
    bru.setVar('testEmail', res.body.data.user.email);
    bru.setVar('testAzureTag', res.body.data.user.azureTag);
  }
}

assert {
  res.status: eq 201
  res.body.data.user.azureTag: isString
  res.body.data.token.accessToken: isString
  res.body.data.account.id: isString
}

tests {
  test("Status is 201 Created", function() {
    expect(res.status).to.equal(201);
  });

  test("Response contains token", function() {
    expect(res.body.data.token.accessToken).to.be.a('string');
    expect(res.body.data.token.accessToken.length).to.be.greaterThan(0);
  });

  test("Response contains user info", function() {
    // The ECHO of what was sent, not a literal. `"Test"` held only under the `local` environment
    // (testFirstName: Test); under `ci` it is "CI", so this failed there from the day it was
    // written - "expected 'CI' to equal 'Test'" - unseen because contract-tests.yml had never run
    // until 2026-09-23 (run 35872727972). And the email line accepted ANY string: it names the
    // address that was actually registered now.
    const sent = req.getBody();
    expect(res.body.data.user.email).to.equal(sent.email);
    expect(res.body.data.user.firstName).to.equal(sent.firstName);
  });

  test("Primary account was created", function() {
    expect(res.body.data.account.isPrimary).to.equal(true);
    expect(res.body.data.account.balance).to.equal(0);
  });
}
