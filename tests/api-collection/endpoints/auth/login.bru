meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-AzureBank-Token-Road: bff
}

body:json {
  {
    "email": "{{testEmail}}",
    "password": "{{testPassword}}"
  }
}

script:post-response {
  // Publish nothing unless this request actually succeeded: a failed request that
  // still writes its variables replaces a good value with an empty one, and every
  // request after it then fails for the wrong reason. Measured 2026-09-21: a 200
  // was assumed and a 401 overwrote the token, turning one broken request into fifteen.
  if (res.getStatus() === 200) {
    bru.setVar('authToken', res.body.data.token.accessToken);
    // The session's grant, for revoke to end.
    bru.setVar('refreshToken', res.body.data.token.refreshToken);
  }
}

assert {
  res.status: eq 200
  res.body.data.token.accessToken: isString
  res.body.data.user.email: isString
}

tests {
  test("Status is 200 OK", function() {
    expect(res.status).to.equal(200);
  });

  test("Response contains JWT token", function() {
    expect(res.body.data.token.accessToken).to.be.a('string');
    expect(res.body.data.token.accessToken.length).to.be.greaterThan(50);
  });

  test("Token appears to be JWT format", function() {
    const token = res.body.data.token.accessToken;
    const parts = token.split('.');
    expect(parts.length).to.equal(3);
  });

  test("Token is the same object register answers", function() {
    // Login used to answer a bare string with expiresAt and refreshToken beside it, while
    // register nested all three in token (measured 2026-09-23). One shape now, and only one.
    // refreshTokenExpiresAt joined it when the grant stopped rotating: the BFF caps its session there.
    // sessionStamp joined it with ADR-0057, section 5.3: the BFF keeps it on the session it creates.
    expect(res.body.data.token).to.have.all.keys(
      'accessToken', 'refreshToken', 'refreshTokenExpiresAt', 'sessionStamp', 'expiresIn', 'tokenType',
      'expiresAt');
    expect(res.body.data.token.sessionStamp).to.be.a('number');
    expect(res.body.data.token.tokenType).to.equal('Bearer');
    expect(res.body.data).to.not.have.any.keys('expiresAt', 'refreshToken');
  });

  test("No access token outlives the grant it came from", function() {
    // The grant's expiry is fixed at sign-in, and every access token minted from it is capped there.
    const grantExpires = Date.parse(res.body.data.token.refreshTokenExpiresAt);
    expect(Number.isNaN(grantExpires)).to.equal(false);
    expect(grantExpires).to.be.at.least(Date.parse(res.body.data.token.expiresAt));
  });

  test("Response contains user info", function() {
    expect(res.body.data.user).to.have.property('id');
    expect(res.body.data.user).to.have.property('email');
    expect(res.body.data.user).to.have.property('azureTag');
  });
}
