meta {
  name: Transfer to User
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/transfers
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  Content-Type: application/json
  Step-Up-Authorization: {{transferAuthorizationId}}
  Idempotency-Key: {{$randomUUID}}
}

body:json {
  {
    "fromAccountId": "{{accountId}}",
    "recipientAzureTag": "{{recipientAzureTag}}",
    "amount": 50.00,
    "description": "Test transfer"
  }
}

assert {
  res.status: eq 201
}

tests {
  test("Status is 201 Created", function() {
    // Everything this needs exists by the time it runs, so 201 is the only right answer.
    // The old assertion also accepted 400 and 404, and the payload checks below sat behind
    // `if (res.status === 201)` -- so a transfer that FAILED passed this request in
    // silence. That is the same "green for the wrong reason" this collection was full of.
    expect(res.status).to.equal(201);
  });

  test("The receipt names the movement, the amount, the new balance and the payee", function() {
    const data = res.body.data;
    expect(data).to.have.property('transactionNumber');
    expect(data).to.have.property('amount');
    expect(data).to.have.property('newBalance');
    expect(data).to.have.property('recipientAzureTag');
  });
}
