// markdownlint configuration for `docs/adr/` only. markdownlint-cli2 reads the config nearest each
// linted file, so this applies to the ADRs and to nothing else in the repository.
{
  // MD040 (fenced-code-language) is off: the bare fences in these records hold measured output, such
  // as a terminal transcript, which has no language.
  "MD040": false
}
