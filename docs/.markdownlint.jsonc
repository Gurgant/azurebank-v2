// markdownlint configuration for the documents at the root of `docs/`. markdownlint-cli2 reads the
// config nearest each linted file, so a folder below with a config of its own does not inherit it.
{
  // MD040 (fenced-code-language) is off: the bare fences in these documents hold measured output
  // and quoted text, which have no language.
  "MD040": false
}
