{
  "ConnectionStrings": {
    // Empty on purpose, as the API's is: the string comes from the environment
    // (ConnectionStrings__DefaultConnection) or from user-secrets, and without one every command
    // exits 2 and says so. Until 2026-10-01 this named a server on localhost, which a container
    // with no secret mapped would have gone looking for.
    "DefaultConnection": ""
  },

  "Database": {
    // The seeder's jobs share the database's 30 logins with the API, whose pool is 12: two API
    // processes during a revision overlap and this pool make 29 (ADR-0058). A Max Pool Size in
    // the connection string still wins.
    "MaxPoolSize": 5
  },

  "SeedData": {
    "DefaultPassword": "Test123!",
    "DefaultPin": "123456",
    "AdminEmail": "admin@azurebank.dev"
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        // EF's own "Applying migration '...'." lines: the record of what a migrate run applied.
        "Microsoft.EntityFrameworkCore.Migrations": "Information",
        "System": "Warning"
      }
    }
  }
}
