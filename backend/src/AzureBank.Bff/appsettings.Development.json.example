{
  // Copy to appsettings.Development.json (git-ignored). Its one secret stays out of this file:
  // ServiceCredential:BffKey, the key the API knows this host by (ADR-0055), set with .NET
  // user-secrets to the SAME value the API holds:
  //   dotnet user-secrets set "ServiceCredential:BffKey" "<the API's ServiceCredential:BffKey>"
  // A placeholder here would become the key whenever that user-secret is missing: the BFF would
  // start and the API would refuse its calls, where without one the BFF refuses to start and
  // says why.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Session": {
    "CookieName": ".AzureBank.Session",
    "InactivityTimeoutMinutes": 10,
    "AbsoluteTimeoutMinutes": 20
  },

  "Security": {
    "PinValidityMinutes": 10
  },

  "ReverseProxy": {
    "Clusters": {
      "backend-api": {
        "HttpClient": {
          "_comment": "DEV ONLY: trust the ASP.NET Core dev cert on the BFF->API hop. This lives in Development config (never base appsettings.json — that would disable TLS validation in production). Mirrors the IsDevelopment() gate on the named 'BackendApi' client.",
          "DangerousAcceptAnyServerCertificate": true
        }
      }
    }
  }
}
