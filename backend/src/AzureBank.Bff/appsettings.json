{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Yarp": "Information",
        "Yarp.ReverseProxy.Forwarder": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "Enrich": ["FromLogContext"]
  },

  "AllowedHosts": "*",

  "Session": {
    "CookieName": ".AzureBank.Session",
    "InactivityTimeoutMinutes": 15,
    "AbsoluteTimeoutMinutes": 60
  },

  "Security": {
    "PinValidityMinutes": 5
  },

  "RateLimiting": {
    "GlobalPermitLimit": 300,
    "GlobalWindowSeconds": 60,
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 60,
    "AuthSegmentsPerWindow": 6,
    "LookupPermitLimit": 20,
    "LookupWindowSeconds": 60
  },

  "ForwardedHeaders": {
    "_comment": "Deployments behind a proxy/LB MUST list the proxy here so the rate limiter partitions on the real client IP: by its exact IPs (KnownProxies), by the networks its IPs come from, in CIDR form (KnownIPNetworks), or both. Both empty = the BFF is the edge; X-Forwarded-For is ignored (never trusted from untrusted sources). See ADR-0013. (Until 2026-10-06 this said 'MUST list the proxy IPs here': KnownProxies was the only list.)",
    "KnownProxies": [],
    "KnownIPNetworks": [],
    "ForwardLimit": 1
  },

  "ReverseProxy": {
    "Routes": {
      "api-auth-login-route": {
        "ClusterId": "backend-api",
        "RateLimiterPolicy": "auth",
        "Match": { "Path": "/api/auth/login" },
        "Transforms": [ { "PathRemovePrefix": "" } ]
      },
      "api-auth-register-route": {
        "ClusterId": "backend-api",
        "RateLimiterPolicy": "auth",
        "Match": { "Path": "/api/auth/register" },
        "Transforms": [ { "PathRemovePrefix": "" } ]
      },
      "api-users-route": {
        "ClusterId": "backend-api",
        "RateLimiterPolicy": "lookup",
        "Match": { "Path": "/api/users/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "" } ]
      },
      "api-route": {
        "ClusterId": "backend-api",
        "Match": {
          "Path": "/api/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "" }
        ]
      }
    },
    "Clusters": {
      "backend-api": {
        "Destinations": {
          "primary": {
            "Address": "https://localhost:7215"
          }
        }
      }
    }
  },

  "BackendApi": {
    "BaseUrl": "https://localhost:7215",
    "TimeoutSeconds": 55
  }
}
