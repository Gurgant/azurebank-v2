<Project Sdk="Microsoft.NET.Sdk">

  <!--
    AzureBank.Infrastructure - Data Access Layer
    Contains: DbContext, Entity Configurations, Migrations, Seeding
    Note: TargetFramework, Nullable, ImplicitUsings inherited from Directory.Build.props
    Note: Package versions managed centrally in Directory.Packages.props
  -->

  <ItemGroup Label="Entity Framework Core">
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Label="Identity">
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup Label="Security patches">
    <!-- Direct reference to lift a vulnerable transitive dependency
         (EF SqlServer -> Microsoft.Data.SqlClient -> System.Security.Cryptography.Xml 9.0.0,
         NU1903). Version pinned centrally in Directory.Packages.props. -->
    <PackageReference Include="System.Security.Cryptography.Xml" />
  </ItemGroup>

  <ItemGroup Label="Hosting and Logging">
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup Label="Configuration (for DesignTimeDbContextFactory)">
    <PackageReference Include="Microsoft.Extensions.Configuration.FileExtensions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
  </ItemGroup>

  <ItemGroup Label="Project References">
    <ProjectReference Include="..\AzureBank.Shared\AzureBank.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      AuditChain.DeriveKeyId turns a chain key into the non-secret identity stored on every row. All
      three of its inputs (algorithm, domain string, truncation length) are frozen the moment the
      first row hashes one, so it needs a known-answer test, and that test has to call the real
      derivation rather than a copy of it. Same reasoning as the equivalent declaration in
      AzureBank.Api.csproj: expose it to the test project rather than widen its accessibility for
      production callers, who have no business deriving key identities themselves.
    -->
    <InternalsVisibleTo Include="AzureBank.Tests" />
  </ItemGroup>

</Project>
