<Project Sdk="Microsoft.NET.Sdk">

  <!--
    AzureBank.Shared - Class Library
    Contains: Entities, DTOs, Constants, Interfaces
    Note: TargetFramework, Nullable, ImplicitUsings inherited from Directory.Build.props
    Note: Package versions managed centrally in Directory.Packages.props
  -->

  <ItemGroup>
    <!-- Identity stores for IdentityUser base class -->
    <PackageReference Include="Microsoft.Extensions.Identity.Stores" />
    <!-- Argon2id PIN hashing (OWASP recommended). Passwords are NOT hashed with this: the API
         registers Identity with no custom password hasher, so they use its PBKDF2 (ADR-0003's
         correction). -->
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" />
  </ItemGroup>

</Project>
