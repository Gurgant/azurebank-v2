# ─── .NET ────────────────────────────────────────────────────────────────────
bin/
obj/
*.user
*.suo
TestResults/
artifacts/
*.binlog

# ─── Local secrets & environment (use user-secrets / env vars instead) ──────
**/appsettings.Development.json
!**/appsettings.Development.json.example
*.pfx
.env
.env.*

# ─── Node / frontend ─────────────────────────────────────────────────────────
node_modules/
dist/
*.local

# ─── Python (schemathesis hooks) ─────────────────────────────────────────────
__pycache__/
*.pyc
.hypothesis/

# ─── Tooling / editor ────────────────────────────────────────────────────────
.vs/
.vscode/
.idea/
*.log
cookies*.txt
graphify-out/

# Playwright (ADR-0031). The auth state holds a LIVE session cookie and must never be committed;
# reports and traces are per-run debugging artefacts.
frontend/e2e/.auth/
frontend/playwright-report/
frontend/test-results/
frontend/blob-report/

# The Functions host's local configuration (ADR-0051). local.settings.json is this machine's
# connection string and pickup directory — the Function's equivalent of the API's user-secrets, and
# the file `func start` reads INSTEAD of environment variables. local.settings.sample.json is
# committed in its place, with the shape and no values worth protecting.
backend/src/AzureBank.Functions.NoticeRelay/local.settings.json

# Azurite's on-disk emulator state, written wherever it is started from. It is a local storage
# account: the timer's schedule rows and the host's singleton lease live in it, and none of it is
# this repository's to carry.
__blobstorage__/
__queuestorage__/
__azurite_db*.json
AzuriteConfig
.azurite/
